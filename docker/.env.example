# 复制成 ~/xa/.env 再填写（和 docker-compose.yml 放在同一目录）。部署要改的配置全在这一个文件里。
# 这个文件只给 docker compose 读，不要提交到 git，不要发到群里。
# 值里有 $ # 空格 引号 等特殊字符时，用单引号整体括起来，例如 KEY='a$b#c'。
# 改完执行 docker compose up -d（会自动重建容器）；只 restart 不会读到新值。

# 容器以哪个用户身份运行：填 id -u 和 id -g 的输出。这样 ~/xa 下的文件不用 chown
XA_UID=1000
XA_GID=1000

# Gateway 控制台 token：openssl rand -base64 32 生成
OPENCLAW_GATEWAY_TOKEN=

# 企业微信机器人（收发消息）
XA_IT_WECOM_BOT_ID=
XA_IT_WECOM_BOT_SECRET=

# 阿里云百炼
XA_DOMESTIC_API_KEY=
XA_DOMESTIC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼控制台里的模型 ID；完整引用 bailian/<模型 ID> 由 compose 自动拼
XA_DOMESTIC_MODEL_ID=

# OA 桥接的独立 MySQL（端口、账号、库名不填时默认 3306 / xa_oa / xa_oa）
OA_MYSQL_HOST=
OA_MYSQL_PORT=3306
OA_MYSQL_USER=xa_oa
OA_MYSQL_DATABASE=xa_oa
OA_MYSQL_PASSWORD=

# OA 应用：appid、RSA 公钥（一整行 base64）、AppSecret、接口账号人员 id（纯数字，只用于只读预检）
OA_APP_ID=
OA_PUBLIC_KEY=
OA_APP_SECRET=
OA_API_USER_ID=

# 真正往 OA 建单：false 时员工确认后只回「还不能创建 OA 工单」，联调完改 true
OA_ACTIVE=false
# 建单后是否自动流转到处理人：0 停在申请人节点（生产测试），1 自动流转
OA_ISNEXTFLOW=0

# 企业微信自建应用（身份转换用，不是上面的机器人）。OA_IDENTITY_ADAPTER=off 可关闭身份转换（不建议）
WECOM_IDENTITY_CORPID=
WECOM_IDENTITY_SECRET=
